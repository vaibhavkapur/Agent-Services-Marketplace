# Shared
NODE_ENV=development
SETTLEMENT_MODE=simulated
DEMO_USER_ID=demo-user
LOG_LEVEL=info

# Database / cache
DATABASE_URL=postgres://asm:asm@localhost:5432/asm
REDIS_URL=redis://localhost:6379

# Service URLs
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
LOOKUP_SERVICE_URL=http://localhost:3002
EXTRACTION_SERVICE_URL=http://localhost:3003
MCP_URL=http://localhost:3004
NEXT_PUBLIC_API_URL=http://localhost:3001

# Isolated signer (demo key — never expose to the model)
SIGNER_SECRET=dev-signer-secret-change-me
PAYER_ADDRESS=0x1111111111111111111111111111111111111111
PAYEE_ADDRESS=0x2222222222222222222222222222222222222222

# x402 V2 exact / Base Sepolia USDC
X402_VERSION=2
X402_SCHEME=exact
X402_NETWORK=eip155:84532
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_ASSET_SYMBOL=USDC
X402_DECIMALS=6
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_MAX_TIMEOUT_SECONDS=60

# MPP tempo.charge / tempo.session (Tempo test environment)
MPP_CHARGE_METHOD=tempo.charge
MPP_SESSION_METHOD=tempo.session
MPP_CHAIN_ID=4217
MPP_CURRENCY=0x20c0000000000000000000000000000000000000
MPP_CURRENCY_SYMBOL=pathUSD
MPP_CURRENCY_DECIMALS=6

# Optional testnet keys — leave empty for simulated rails
EVM_PRIVATE_KEY=
MPP_SECRET_KEY=
